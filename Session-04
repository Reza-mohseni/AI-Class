import math
import matplotlib.pyplot as plt
import numpy as np


banana_lengths = [18, 20, 17, 22]
banana_widths = [3.5, 4.0, 3.2, 4.2]

apple_lengths = [8, 7.5, 8.5, 9]
apple_widths = [7.5, 8.0, 8.2, 8.5]

train_data = []
test_data = []

for i in range(len(banana_lengths)):
    sample = [banana_lengths[i], banana_widths[i], 0]
    (train_data if i < 3 else test_data).append(sample)

for i in range(len(apple_lengths)):
    sample = [apple_lengths[i], apple_widths[i], 1]
    (train_data if i < 3 else test_data).append(sample)

train_data = np.array(train_data)
test_data = np.array(test_data)

X_train, y_train = train_data[:, :2], train_data[:, 2]
X_test, y_test = test_data[:, :2], test_data[:, 2]

# ۳. طبقه‌بندی میوه جدید با k-NN (محاسبه برداری)
new_fruit = np.array([19.0, 3.8])

# فاصله اقلیدسی همه نقاط آموزش تا میوه جدید در یک خط
distances = np.linalg.norm(X_train - new_fruit, axis=1)


k = 1
nearest_neighbor_idx = np.argmin(distances)
predicted_label = int(y_train[nearest_neighbor_idx])
predicted_name = "موز" if predicted_label == 0 else "سیب"

print(
    f"پیش‌بینی برای میوه جدید: {predicted_name} (کمترین فاصله: {distances[nearest_neighbor_idx]:.2f})"
)


correct_predictions = 0
for idx, test_sample in enumerate(X_test):
    test_dists = np.linalg.norm(X_train - test_sample, axis=1)
    pred = int(y_train[np.argmin(test_dists)])
    if pred == y_test[idx]:
        correct_predictions += 1

accuracy = (correct_predictions / len(X_test)) * 100
print(f"دقت روی داده‌های تست: {accuracy:.0f}%")


plt.figure(figsize=(8, 6))
plt.scatter(
    X_train[y_train == 0, 0],
    X_train[y_train == 0, 1],
    color="orange",
    label="Banana (Train)",
    s=70,
)
plt.scatter(
    X_train[y_train == 1, 0],
    X_train[y_train == 1, 1],
    color="red",
    label="Apple (Train)",
    s=70,
)
plt.scatter(
    new_fruit[0],
    new_fruit[1],
    color="green",
    marker="*",
    s=200,
    label=f"New Fruit ({predicted_name})",
)
plt.scatter(
    X_test[:, 0],
    X_test[:, 1],
    color="purple",
    marker="X",
    s=100,
    label="Test Samples",
)

plt.xlabel("Length (طول)")
plt.ylabel("Width (عرض)")
plt.title("Fruit Classification using k-NN")
plt.legend()
plt.grid(True)
plt.show()
